# Copy this file to .env and edit values before running in production.

# Server
PORT=3000
NODE_ENV=production

# Comma-separated list of allowed cross-origin frontends (leave blank to disable CORS).
# Example: ALLOWED_ORIGINS=https://timesheet.appartners.in,https://internal.appartners.in
ALLOWED_ORIGINS=

# Auth
# Generate a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Database file
DB_PATH=./database/aptimesheet.db

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Firm details (used on invoices)
FIRM_NAME=AP & Partners
FIRM_TAGLINE=Advocates & Solicitors
FIRM_ADDRESS_LINE1=
FIRM_ADDRESS_LINE2=
FIRM_CITY=
FIRM_PHONE=+91-9911503786
FIRM_EMAIL=it@appartners.in
FIRM_GSTIN=
INVOICE_PREFIX=AP
DEFAULT_CURRENCY=INR

# ─── Email / SMTP — Microsoft Office 365 / Outlook ────────────────────
# IMPORTANT: keep this file (.env) OUT of git. Treat SMTP_PASS like any other secret.
# Rotate SMTP_PASS immediately if .env was ever committed or shared.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=accounts@appartners.in
SMTP_PASS=
SMTP_FROM=accounts@appartners.in
